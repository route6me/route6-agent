    "url": "git+https://github.com/route6me/route6-agent.git"
  },
  "bugs": {
    "url": "https://github.com/route6me/route6-agent/issues",
    "email": "info@route6.me"
  },
  "keywords": ["route6", "mcp", "tunnel", "ipv6", "agent", "ai-agent", "model-context-protocol"],
  "type": "module",
